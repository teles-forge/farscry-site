<section id="diff">
  <div class="section-label">Automatic Diff</div>
  <h2>38ms instead of 5 seconds, every action.</h2>
  <p class="section-sub">After an action, farscry diffs before → after. No re-upload. No tokens wasted on pixels that didn't change.</p>

  <div class="diff-timeline">
    <div class="diff-track diff-track--bad">
      <span class="diff-track-who">without</span>
      <div class="diff-steps">
        <span class="diff-step">action</span>
        <span class="diff-arr">→</span>
        <span class="diff-step diff-step--bad">re-screenshot</span>
        <span class="diff-arr">→</span>
        <span class="diff-step diff-step--bad">1,568 tokens to cloud</span>
        <span class="diff-arr">→</span>
        <span class="diff-step diff-step--bad">wait 2-5s</span>
        <span class="diff-arr">→</span>
        <span class="diff-step">read result</span>
      </div>
      <span class="diff-track-price">~$0.0047 · ~3 seconds</span>
    </div>
    <div class="diff-track diff-track--good">
      <span class="diff-track-who">farscry</span>
      <div class="diff-steps">
        <span class="diff-step">action</span>
        <span class="diff-arr">→</span>
        <span class="diff-step diff-step--good">farscry diff</span>
        <span class="diff-arr">→</span>
        <span class="diff-step diff-step--good">38ms</span>
        <span class="diff-arr">→</span>
        <span class="diff-step">read result</span>
      </div>
      <span class="diff-track-price">$0</span>
    </div>
  </div>
</section>

