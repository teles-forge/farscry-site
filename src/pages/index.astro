<!-- ═══════════════ SCRIPTS ═══════════════ -->
<script is:inline>
(function () {

  const CMD = '$ farscry screen.png';
  const OUTPUT = [
    '<span class="d">\u2192</span> <span class="k">button</span>  <span class="s">"Save"</span>           <span class="d">at (400,300)</span>  <span class="appeared">enabled:true</span>',
    '<span class="d">\u2192</span> <span class="k">button</span>  <span class="s">"Cancel"</span>         <span class="d">at (500,300)</span>  <span class="appeared">enabled:true</span>',
    '<span class="d">\u2192</span> <span class="k">input</span>   <span class="s">"Card number"</span>    <span class="d">at (300,200)</span>  <span class="changed">empty:true</span>',
    '<span class="d">\u2192</span> <span class="k">input</span>   <span class="s">"Expiry date"</span>    <span class="d">at (300,250)</span>  <span class="changed">empty:true</span>',
    '<span class="d">\u2192</span> <span class="k">input</span>   <span class="s">"CVV"</span>            <span class="d">at (420,250)</span>  <span class="changed">empty:true</span>',
    '<span class="d">\u2192</span> <span class="k">text</span>    <span class="s">"Amount"</span>         <span class="d">at (300,150)</span>  <span class="s">value:"$24.99"</span>',
  ];

  function sleep(ms) {
    return new Promise(function (r) { setTimeout(r, ms); });
  }

  async function runTerminal(body) {
    if (!body || !body.isConnected) return;
    body.innerHTML = '';


    var cmdDiv = document.createElement('div');
    cmdDiv.className = 'tl';
    var cmdSpan = document.createElement('span');
    cmdSpan.className = 'cmd';
    var cursor = document.createElement('span');
    cursor.className = 'cursor';
    cursor.textContent = '\u25ae';
    cmdDiv.appendChild(cmdSpan);
    cmdDiv.appendChild(cursor);
    body.appendChild(cmdDiv);

    await sleep(400);


    for (var i = 0; i < CMD.length; i++) {
      cmdSpan.textContent += CMD[i];
      await sleep(24);
    }

    cursor.remove();
    await sleep(220);


    for (var j = 0; j < OUTPUT.length; j++) {
      if (!body.isConnected) return;
      var el = document.createElement('div');
      el.className = 'tl animate';
      if (OUTPUT[j] === null) {
        el.innerHTML = '&nbsp;';
      } else {
        el.innerHTML = OUTPUT[j];
      }
      body.appendChild(el);
      await sleep(62);
    }


    await sleep(4800);
    runTerminal(body);
  }

  var tterm = document.querySelector('[data-terminal-output]');
  if (tterm) runTerminal(tterm);


  (function () {
    var el = document.getElementById('gh-star-count');
    if (!el) return;
    fetch('https://api.github.com/repos/teles-forge/farscry', {
      headers: { Accept: 'application/vnd.github+json' },
      cache: 'force-cache'
    })
    .then(function (r) { return r.json(); })
    .then(function (d) {
      var n = d.stargazers_count;
      if (typeof n === 'number') {
        el.textContent = n >= 1000
          ? (n / 1000).toFixed(1).replace(/\.0$/, '') + 'k'
          : String(n);
      }
    })
    .catch(function () {  });
  })();


  var benchChart = document.getElementById('bench-chart');
  if (benchChart && 'IntersectionObserver' in window) {
    var observer = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) {
          entry.target.querySelectorAll('.bench-row').forEach(function (row) {
            row.classList.add('in-view');
          });
          observer.disconnect();
        }
      });
    }, { threshold: 0.3 });
    observer.observe(benchChart);
  } else if (benchChart) {

    benchChart.querySelectorAll('.bench-row').forEach(function (r) {
      r.classList.add('in-view');
    });
  }

  /* ── Copy buttons on install commands ── */
  document.querySelectorAll('.im-copy').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var cmd = btn.closest('.install-method').querySelector('.im-cmd').textContent.trim();
      navigator.clipboard.writeText(cmd).then(function () {
        btn.textContent = 'copied';
        btn.classList.add('copied');
        setTimeout(function () {
          btn.textContent = 'copy';
          btn.classList.remove('copied');
        }, 1600);
      }).catch(function () {
        /* fallback: select the text */
        var el = btn.closest('.install-method').querySelector('.im-cmd');
        var range = document.createRange();
        range.selectNodeContents(el);
        window.getSelection().removeAllRanges();
        window.getSelection().addRange(range);
      });
    });
  });
})();
</script>

</body>
</html>
