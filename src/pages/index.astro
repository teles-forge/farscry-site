<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>farscry - vision APIs describe. farscry gives coordinates.</title>
  <meta name="description" content="Up to 15x fewer tokens than remote screenshot processing. 38ms on M4 Pro. Offline. $0. farscry gives agents exact pixel coordinates - not descriptions. Agents that act, not guess." />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --accent:      #6366f1;
      --accent-low:  #1e1b4b;
      --accent-mid:  #4f46e5;
      --accent-high: #a5b4fc;
      --cyan:        #22d3ee;
      --cyan-low:    rgba(34,211,238,0.12);
      --bg:          #020617;
      --bg-card:     #0f1629;
      --bg-code:     #131b2e;
      --border:      #1e293b;
      --border-soft: rgba(30,41,59,0.6);
      --text:        #e2e8f0;
      --text-muted:  #94a3b8;
      --text-dim:    #475569;
      --success:     #22c55e;
      --warn:        #f59e0b;
      --danger:      #f87171;
      --mono: 'JetBrains Mono', 'Fira Code', monospace;
      --sans: 'Inter', system-ui, sans-serif;
    }

    html { scroll-behavior: smooth; }
    body {
      background: var(--bg);
      color: var(--text);
      font-family: var(--sans);
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
    }


    nav {
      position: sticky; top: 0; z-index: 50;
      display: flex; align-items: center; justify-content: space-between;
      padding: 0.8rem 2rem;
      background: rgba(2,6,23,0.88);
      backdrop-filter: blur(14px);
      border-bottom: 1px solid var(--border-soft);
    }
    .nav-brand {
      display: flex; align-items: center; gap: 0.55rem;
      text-decoration: none;
    }
    .nav-brand svg { width: 22px; height: 22px; flex-shrink: 0; }
    .nav-wordmark {
      font-family: var(--mono);
      font-size: 1.0625rem;
      font-weight: 500;
      color: var(--accent-high);
      letter-spacing: -0.01em;
    }
    .nav-links { display: flex; gap: 1.5rem; align-items: center; }
    .nav-links a {
      color: var(--text-muted); text-decoration: none;
      font-size: 0.875rem; transition: color 0.15s;
    }
    .nav-links a:hover { color: var(--text); }

    .nav-star {
      display: inline-flex; align-items: center; gap: 0.35rem;
      color: var(--text-muted) !important;
      border: 1px solid var(--border);
      border-radius: 5px;
      padding: 0.3rem 0.625rem;
      font-size: 0.8125rem; font-family: var(--mono);
      transition: border-color 0.15s, color 0.15s !important;
    }
    .nav-star:hover {
      border-color: rgba(99,102,241,0.5) !important;
      color: var(--accent-high) !important;
    }
    .nav-star svg { flex-shrink: 0; }
    .nav-star-count {
      color: var(--text-dim);
      font-size: 0.75rem;
    }
    .btn-nav {
      background: var(--accent); color: white !important;
      padding: 0.375rem 0.875rem; border-radius: 6px;
      font-size: 0.875rem; font-weight: 500;
    }
    .btn-nav:hover { background: var(--accent-mid) !important; }


    .hero-wrap {
      position: relative; overflow: hidden;
    }
    .hero-wrap::after {

      content: '';
      position: absolute; inset: 0;
      background:
        radial-gradient(ellipse 55% 45% at 75% 20%, rgba(99,102,241,0.07) 0%, transparent 70%),
        linear-gradient(to bottom, transparent 55%, var(--bg) 100%);
      pointer-events: none;
    }
    .hero {
      position: relative; z-index: 1;
      max-width: 1100px; margin: 0 auto;
      padding: 5.5rem 2rem 4rem;
      display: grid; grid-template-columns: 1fr 1fr; gap: 3.5rem; align-items: center;
    }
    @media (max-width: 820px) {
      .hero { grid-template-columns: 1fr; gap: 2.5rem; padding: 3rem 1.25rem 2rem; }
    }


    .hero-badge {
      display: inline-flex; align-items: center; gap: 0.625rem;
      background: transparent;
      color: var(--text-muted);
      border: 1px solid var(--border);
      padding: 0.25rem 0.75rem;
      border-radius: 4px;
      font-family: var(--mono);
      font-size: 0.75rem; font-weight: 400;
      letter-spacing: 0;
      margin-bottom: 1.5rem;
    }
    .hero-badge-version {
      color: var(--accent-high); font-weight: 600;
    }
    .hero-badge-sep {
      color: var(--text-dim);
    }

    h1 {
      font-size: clamp(2rem, 5vw, 2.875rem);
      font-weight: 800;
      letter-spacing: -0.035em;
      line-height: 1.12;
      color: #f1f5f9;
      margin-bottom: 1rem;
    }
    h1 em {
      font-style: normal;
      color: var(--accent-high);
    }
    .hero-sub {
      color: var(--text-muted);
      font-size: 1rem; line-height: 1.65;
      margin-bottom: 2rem;
      max-width: 480px;
    }
    .hero-sub strong { color: var(--text); font-weight: 600; }

    .hero-buttons { display: flex; gap: 0.75rem; flex-wrap: wrap; margin-bottom: 2rem; }
    .btn {
      display: inline-flex; align-items: center; gap: 0.4rem;
      padding: 0.625rem 1.25rem;
      border-radius: 8px;
      font-size: 0.9375rem; font-weight: 600;
      text-decoration: none;
      transition: all 0.15s;
    }
    .btn-primary { background: var(--accent); color: white; }
    .btn-primary:hover { background: var(--accent-mid); transform: translateY(-1px); box-shadow: 0 4px 14px rgba(99,102,241,0.4); }
    .btn-outline {
      background: transparent; color: var(--text);
      border: 1px solid var(--border);
    }
    .btn-outline:hover { border-color: var(--accent); color: var(--accent-high); }


    .hero-flows {
      display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;
    }
    .flow-box {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 1rem 1.125rem;
      font-size: 0.8125rem;
    }
    .flow-box--bad  { border-color: rgba(248,113,113,0.25); }
    .flow-box--good { border-color: rgba(34,197,94,0.25); }
    .flow-header {
      display: flex; align-items: center; gap: 0.4rem;
      font-family: var(--mono); font-size: 0.6875rem; font-weight: 600;
      text-transform: uppercase; letter-spacing: 0.08em;
      margin-bottom: 0.75rem;
    }
    .flow-header--bad  { color: var(--danger); }
    .flow-header--good { color: var(--success); }
    .flow-step {
      display: flex; align-items: flex-start; gap: 0.5rem;
      color: var(--text-muted);
      font-size: 0.78125rem;
      line-height: 1.4;
      padding: 0.3rem 0;
    }
    .flow-step-icon { flex-shrink: 0; font-size: 0.875rem; line-height: 1.4; }
    .flow-step-sub {
      display: block;
      font-size: 0.6875rem;
      color: var(--text-dim);
      margin-top: 0.1rem;
    }
    .flow-arrow {
      text-align: center;
      color: var(--text-dim);
      font-size: 0.75rem;
      padding: 0.1rem 0;
      padding-left: 1.375rem;
    }
    .flow-result {
      margin-top: 0.5rem;
      background: var(--bg-code);
      border: 1px solid var(--border);
      border-radius: 5px;
      padding: 0.375rem 0.625rem;
      font-family: var(--mono);
      font-size: 0.6875rem;
      line-height: 1.5;
    }
    .flow-result--bad  { color: var(--danger); opacity: 0.7; }
    .flow-result--good { color: var(--success); }


    .hero-output {
      background: var(--bg-code);
      border: 1px solid rgba(99,102,241,0.35);
      border-radius: 10px;
      padding: 0.875rem 1.25rem;
      font-family: var(--mono);
      font-size: 0.8125rem;
      line-height: 1.8;
    }
    .hero-output-cmd { color: #f1f5f9; margin-bottom: 0.5rem; }
    .hero-output-row { display: block; }
    .hor  { color: var(--text-dim); margin-right: 0.375rem; }
    .hok  { color: #60a5fa; display: inline-block; min-width: 4rem; }
    .hos  { color: #4ade80; }
    .hod  { color: var(--text-dim); }
    .hog  { color: var(--success); }
    .hob  { color: var(--danger); }


    .pos { color: var(--cyan); }


    .terminal-wrap {
      position: relative;
    }
    .terminal-wrap::before {
      content: '';
      position: absolute; inset: -30px;
      background: radial-gradient(ellipse 80% 60% at 50% 50%, rgba(99,102,241,0.12) 0%, transparent 70%);
      pointer-events: none; z-index: 0;
    }
    .terminal {
      position: relative; z-index: 1;
      background: #0d1117;
      border: 1px solid #1e2433;
      border-radius: 12px;
      overflow: hidden;
      font-family: var(--mono);
      font-size: 0.8125rem;
      box-shadow: 0 20px 60px rgba(0,0,0,0.7), 0 0 0 1px rgba(99,102,241,0.1);
    }
    .terminal-bar {
      background: #1c1f2e;
      padding: 0.6rem 1rem;
      display: flex; align-items: center; gap: 0.5rem;
      border-bottom: 1px solid #252840;
    }
    .dot { width: 12px; height: 12px; border-radius: 50%; }
    .dot-r { background: #ff5f57; }
    .dot-y { background: #ffbd2e; }
    .dot-g { background: #28c840; }
    .terminal-title {
      margin: 0 auto;
      font-size: 0.6875rem; color: var(--text-dim);
      font-family: var(--sans);
    }
    .terminal-output {
      padding: 1.25rem; line-height: 1.75;
      min-height: 14rem;
    }

    .tl { display: block; }
    @keyframes tFadeIn {
      from { opacity: 0; transform: translateX(-3px); }
      to   { opacity: 1; transform: translateX(0); }
    }
    .tl.animate { animation: tFadeIn 0.07s ease forwards; }


    .cmd   { color: #f1f5f9; }
    .k     { color: #60a5fa; }
    .s     { color: #4ade80; }
    .d     { color: var(--text-dim); }
    .sec   { color: var(--warn); }
    .appeared { color: var(--success); font-weight: 500; }
    .changed  { color: var(--warn);    font-weight: 500; }
    .removed  { color: var(--danger);  font-weight: 500; }
    .punc  { color: var(--text-dim); }


    .cursor {
      display: inline-block;
      color: var(--accent-high);
      animation: blink 1s step-end infinite;
    }
    @keyframes blink {
      0%, 100% { opacity: 1; }
      50%       { opacity: 0; }
    }


    section { max-width: 1100px; margin: 0 auto; padding: 6rem 2rem; }
    @media (max-width: 820px) { section { padding: 3.5rem 1.25rem; } }
    .section-label {
      font-size: 0.6875rem; font-weight: 700; text-transform: uppercase;
      letter-spacing: 0.12em; color: var(--cyan);
      margin-bottom: 0.625rem;
    }
    h2 {
      font-size: clamp(1.5rem, 3vw, 2rem);
      font-weight: 700;
      letter-spacing: -0.025em;
      color: #f1f5f9;
      margin-bottom: 0.5rem;
    }
    .section-sub {
      color: var(--text-muted); font-size: 1rem;
      margin-bottom: 2.5rem;
    }
    .divider {
      border: none; border-top: 1px solid var(--border-soft);
      max-width: 1100px; margin: 0 auto;
    }


    .feature-grid {
      display: grid; grid-template-columns: 1fr 1fr; gap: 3.5rem; align-items: start;
    }
    @media (max-width: 820px) { .feature-grid { grid-template-columns: 1fr; gap: 2rem; } }
    .feature-desc p {
      color: var(--text-muted); font-size: 0.9375rem; line-height: 1.7; margin-bottom: 1rem;
    }
    .feature-stats {
      display: flex; gap: 0.75rem; flex-wrap: wrap; margin-top: 1.25rem;
    }
    .feature-stat {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 0.625rem 1rem;
      text-align: center;
    }
    .feature-stat-num {
      display: block;
      font-family: var(--mono); font-size: 1.25rem; font-weight: 700;
      color: var(--cyan); line-height: 1.2; letter-spacing: -0.03em;
    }
    .feature-stat-label {
      display: block; font-size: 0.75rem; color: var(--text-muted); margin-top: 0.2rem;
    }


    .loop-compare {
      display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem;
    }
    @media (max-width: 820px) { .loop-compare { grid-template-columns: 1fr; } }
    .loop-box {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 1.25rem;
    }
    .loop-box--bad  { border-color: rgba(248,113,113,0.2); }
    .loop-box--good { border-color: rgba(34,197,94,0.2); }
    .loop-title {
      font-family: var(--mono); font-size: 0.6875rem; font-weight: 600;
      text-transform: uppercase; letter-spacing: 0.08em;
      margin-bottom: 1rem;
    }
    .loop-title--bad  { color: var(--danger); }
    .loop-title--good { color: var(--success); }
    .loop-steps { display: flex; flex-direction: column; gap: 0; }
    .loop-item {
      display: flex; align-items: flex-start; gap: 0.625rem;
      padding: 0.375rem 0;
      font-size: 0.8125rem; color: var(--text-muted);
    }
    .loop-item-icon { flex-shrink: 0; width: 1.25rem; text-align: center; }
    .loop-item-connector {
      width: 1px; height: 1rem;
      background: var(--border);
      margin-left: 0.5625rem;
      margin-top: -0.125rem; margin-bottom: -0.125rem;
    }
    .loop-cost {
      margin-top: 0.875rem;
      padding-top: 0.875rem;
      border-top: 1px solid var(--border-soft);
      font-family: var(--mono); font-size: 0.8125rem;
    }
    .loop-cost-bad  { color: var(--danger); }
    .loop-cost-good { color: var(--success); }


    .bench-stat-row {
      display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem;
      margin-bottom: 3rem;
    }
    @media (max-width: 820px) { .bench-stat-row { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 480px) { .bench-stat-row { grid-template-columns: 1fr; } }
    .bench-stat {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 1.25rem 1.5rem;
      text-align: center;
    }
    .bench-stat-num {
      display: block;
      font-family: var(--mono);
      font-size: 2rem; font-weight: 700;
      color: var(--cyan);
      line-height: 1.15;
      letter-spacing: -0.03em;
    }
    .bench-stat-label {
      display: block;
      font-size: 0.8125rem; color: var(--text-muted);
      margin-top: 0.25rem;
    }


    .bench-chart { margin-bottom: 2.5rem; }
    .bench-row {
      display: grid;
      grid-template-columns: 7rem 1fr 6rem;
      align-items: center;
      gap: 0.75rem;
      margin-bottom: 0.875rem;
    }
    @media (max-width: 600px) {
      .bench-row { grid-template-columns: 5.5rem 1fr 5rem; gap: 0.5rem; }
    }
    .bench-name {
      font-size: 0.8125rem; font-weight: 600;
      color: var(--text); text-align: right;
    }
    .bench-name.ours { color: var(--accent-high); }
    .bench-track {
      position: relative;
      height: 28px;
      background: rgba(255,255,255,0.03);
      border: 1px solid var(--border-soft);
      border-radius: 4px;
      overflow: hidden;
    }
    .bench-bar {
      position: absolute; top: 0; left: 0;
      height: 100%;
      border-radius: 3px;
      transform: scaleX(0);
      transform-origin: left center;
      transition: transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .bench-row.in-view .bench-bar { transform: scaleX(1); }

    /* farscry bar is nearly invisible at scale — THAT IS THE MESSAGE */
    .bench-bar--ours {
      width: max(6px, 1%);  /* 38/3800 ≈ 1% */
      background: linear-gradient(to right, var(--accent), #818cf8);
    }
    .bench-bar--mid {
      width: 65.8%;  /* 2500/3800 */
      background: var(--text-dim);
    }
    .bench-bar--slow {
      width: 100%;
      background: linear-gradient(to right, #7f1d1d, #991b1b);
    }
    .bench-num {
      font-family: var(--mono);
      font-size: 0.8125rem;
      color: var(--text-muted);
    }
    .bench-num.ours {
      color: var(--accent-high); font-weight: 600;
    }
    .bench-mult {
      display: inline-block;
      background: rgba(127,29,29,0.25);
      color: var(--danger);
      border-radius: 3px;
      padding: 0 0.3rem;
      font-size: 0.7rem;
      font-family: var(--mono);
      margin-left: 0.3rem;
    }


    .bench-failure-callout {
      display: flex; align-items: center; gap: 1.5rem;
      background: rgba(248,113,113,0.05);
      border: 1px solid rgba(248,113,113,0.2);
      border-radius: 10px;
      padding: 1.125rem 1.5rem;
      margin-bottom: 2.5rem;
      flex-wrap: wrap;
    }
    .bfc-num {
      font-family: var(--mono); font-size: 2.75rem; font-weight: 700;
      color: var(--danger); flex-shrink: 0; line-height: 1;
    }
    .bfc-text {
      flex: 1; min-width: 200px;
      font-size: 0.9375rem; color: var(--text-muted); line-height: 1.55;
    }
    .bfc-text strong { color: var(--text); }
    .bfc-source {
      display: block; margin-top: 0.3rem;
      font-family: var(--mono); font-size: 0.75rem; color: var(--text-dim);
    }


    .bench-cost-callout {
      display: flex; align-items: center; gap: 1.5rem;
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 1.125rem 1.5rem;
      margin-bottom: 2.5rem;
      flex-wrap: wrap;
    }
    .cost-item {
      display: flex; flex-direction: column; align-items: center;
    }
    .cost-num {
      font-family: var(--mono); font-size: 1.375rem; font-weight: 700;
      line-height: 1.2;
    }
    .cost-num--bad { color: var(--danger); }
    .cost-num--good { color: var(--success); }
    .cost-label { font-size: 0.75rem; color: var(--text-muted); margin-top: 0.2rem; }
    .cost-arrow {
      font-size: 1.25rem; color: var(--text-dim); flex-shrink: 0;
    }
    .cost-context {
      flex: 1; min-width: 200px;
      font-size: 0.875rem; color: var(--text-muted); line-height: 1.5;
    }
    .cost-context strong { color: var(--text); }

    .bench-repro {
      text-align: center; margin-top: 0.5rem;
    }
    .bench-repro a {
      font-family: var(--mono); font-size: 0.8125rem; color: var(--text-dim);
      text-decoration: none;
    }
    .bench-repro a:hover { color: var(--accent-high); }


    .cards {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1.25rem;
    }
    @media (max-width: 820px) { .cards { grid-template-columns: 1fr; } }
    .card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 1.5rem;
      transition: border-color 0.15s, transform 0.15s;
    }
    .card:hover { border-color: rgba(99,102,241,0.45); transform: translateY(-2px); }
    .card-tag {
      display: inline-block;
      font-family: var(--mono); font-size: 0.6875rem; font-weight: 600;
      color: var(--accent-high);
      background: var(--accent-low);
      border: 1px solid rgba(99,102,241,0.3);
      padding: 0.15rem 0.5rem;
      border-radius: 4px;
      margin-bottom: 0.875rem;
      letter-spacing: 0.04em;
    }
    .card h3 { font-size: 1rem; font-weight: 600; color: #f1f5f9; margin-bottom: 0.375rem; }
    .card p { font-size: 0.875rem; color: var(--text-muted); margin-bottom: 1rem; line-height: 1.55; }
    .card-code {
      background: var(--bg-code);
      border: 1px solid var(--border);
      border-radius: 6px;
      padding: 0.625rem 0.875rem;
      font-family: var(--mono);
      font-size: 0.78125rem;
      color: var(--cyan);
      line-height: 1.5;
    }


    .install-ways {
      display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem;
      margin-bottom: 2rem;
    }
    @media (max-width: 820px) { .install-ways { grid-template-columns: 1fr; } }
    .install-way {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 1.5rem;
      transition: border-color 0.15s, transform 0.15s;
    }
    .install-way:hover { border-color: rgba(99,102,241,0.45); transform: translateY(-2px); }
    .install-way-letter {
      display: flex; align-items: center; justify-content: center;
      width: 2rem; height: 2rem;
      background: var(--accent-low);
      border: 1px solid rgba(99,102,241,0.3);
      border-radius: 6px;
      font-family: var(--mono); font-size: 0.875rem; font-weight: 700;
      color: var(--accent-high);
      margin-bottom: 0.875rem;
    }
    .install-way h3 { font-size: 1rem; font-weight: 600; color: #f1f5f9; margin-bottom: 0.375rem; }
    .install-way p { font-size: 0.875rem; color: var(--text-muted); margin-bottom: 1rem; line-height: 1.55; }
    .code-block {
      background: var(--bg-code);
