<section id="benchmark">
  <div class="section-label">Performance</div>

  <div class="perf-hero">
    <span class="perf-number">65<span class="perf-number-unit">×</span></span>
    <div class="perf-context">faster than Tesseract on 4K screens</div>
    <div class="perf-meta">38ms warm · $0 · offline · N=223, ScreenSpot-Pro (MIT)</div>
  </div>

  <div class="perf-stats-row">
    <div class="perf-stat-item">
      <span class="perf-stat-big">65<span style="color:var(--accent-high)">×</span></span>
      <span class="perf-stat-l1">faster · 4K screens</span>
