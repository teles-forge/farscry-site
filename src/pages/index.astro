---

---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>farscry - vision APIs describe. farscry gives coordinates.</title>
  <meta name="description" content="Up to 15x fewer tokens than remote screenshot processing. 38ms on M4 Pro. Offline. $0. farscry gives agents exact pixel coordinates - not descriptions. Agents that act, not guess." />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --accent:      #6366f1;
      --accent-low:  #18163a;
      --accent-mid:  #4f46e5;
      --accent-high: #a5b4fc;
      --cyan:        #22d3ee;
      --cyan-low:    rgba(34,211,238,0.10);
      --bg:          #09090b;
      --bg-card:     #111116;
      --bg-code:     #0d0d11;
      --border:      rgba(255,255,255,0.08);
      --border-soft: rgba(255,255,255,0.05);
      --text:        #f2f2f4;
      --text-muted:  #a0a0a8;
      --text-dim:    #4a4a55;
      --success:     #22c55e;
      --warn:        #f59e0b;
      --danger:      #f87171;
      --mono: 'JetBrains Mono', 'Fira Code', monospace;
      --sans: 'Inter', system-ui, sans-serif;
    }

    html { scroll-behavior: smooth; }
    body {
      background: var(--bg);
      color: var(--text);
      font-family: var(--sans);
      font-size: 1rem;
      line-height: 1.65;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
      font-feature-settings: "cv02" 1, "cv03" 1, "cv04" 1;
    }


    nav {
      position: sticky; top: 0; z-index: 50;
      display: flex; align-items: center; justify-content: space-between;
      padding: 0.8rem 2rem;
      background: rgba(9,9,11,0.85);
      backdrop-filter: blur(16px) saturate(180%);
      border-bottom: 1px solid var(--border-soft);
    }
    .nav-brand {
      display: flex; align-items: center; gap: 0.55rem;
      text-decoration: none;
    }
    .nav-brand svg { width: 22px; height: 22px; flex-shrink: 0; }
    .nav-wordmark {
      font-family: var(--mono);
      font-size: 1.0625rem;
      font-weight: 500;
      color: var(--accent-high);
      letter-spacing: -0.01em;
    }
    .nav-links { display: flex; gap: 1.5rem; align-items: center; }
    .nav-links a {
      color: var(--text-muted); text-decoration: none;
      font-size: 0.875rem; transition: color 0.15s;
    }
    .nav-links a:hover { color: var(--text); }

    .nav-star {
      display: inline-flex; align-items: center; gap: 0.35rem;
      color: var(--text-muted) !important;
      border: 1px solid var(--border);
      border-radius: 5px;
      padding: 0.3rem 0.625rem;
      font-size: 0.8125rem; font-family: var(--mono);
      transition: border-color 0.15s, color 0.15s !important;
    }
    .nav-star:hover {
      border-color: rgba(99,102,241,0.5) !important;
      color: var(--accent-high) !important;
    }
    .nav-star svg { flex-shrink: 0; }
    .nav-star-count {
      color: var(--text-dim);
      font-size: 0.75rem;
    }
    .btn-nav {
      background: var(--accent); color: white !important;
      padding: 0.375rem 0.875rem; border-radius: 6px;
      font-size: 0.875rem; font-weight: 500;
    }
    .btn-nav:hover { background: var(--accent-mid) !important; }


    .hero-wrap {
      position: relative; overflow: hidden;
      background-image: radial-gradient(circle, rgba(255,255,255,0.03) 1px, transparent 1px);
      background-size: 28px 28px;
    }
    .hero-wrap::after {
      content: '';
      position: absolute; inset: 0;
      background: radial-gradient(ellipse 70% 60% at 50% 0%, rgba(99,102,241,0.06) 0%, transparent 70%),
        linear-gradient(to bottom, transparent 60%, var(--bg) 100%);
      pointer-events: none;
    }
    .hero {
      position: relative; z-index: 1;
      max-width: 1100px; margin: 0 auto;
      padding: 4rem 2rem 3rem;
      display: grid; grid-template-columns: 1fr 1fr; gap: 3.5rem; align-items: center;
    }
    @media (max-width: 820px) {
      .hero { grid-template-columns: 1fr; gap: 2.5rem; padding: 3rem 1.25rem 2rem; }
    }


    .hero-badge {
      display: inline-flex; align-items: center; gap: 0.625rem;
      background: transparent;
      color: var(--text-muted);
      border: 1px solid var(--border);
      padding: 0.25rem 0.75rem;
      border-radius: 4px;
      font-family: var(--mono);
      font-size: 0.75rem; font-weight: 400;
      letter-spacing: 0;
      margin-bottom: 1.5rem;
    }
    .hero-badge-version {
      color: var(--accent-high); font-weight: 600;
    }
    .hero-badge-sep {
      color: var(--text-dim);
    }

    h1 {
      font-size: clamp(2.5rem, 5.5vw, 3.75rem);
      font-weight: 700;
      letter-spacing: -0.04em;
      line-height: 1.06;
      color: var(--text);
      margin-bottom: 1.25rem;
    }
    h1 em {
      font-style: normal;
      color: var(--accent-high);
    }
    .hero-sub {
      color: var(--text-muted);
      font-size: 1.0625rem; line-height: 1.7;
      margin-bottom: 2rem;
      max-width: 480px;
    }
    .hero-sub strong { color: var(--text); font-weight: 600; }

    .hero-buttons { display: flex; gap: 0.75rem; flex-wrap: wrap; margin-bottom: 2rem; }
    .btn {
      display: inline-flex; align-items: center; gap: 0.4rem;
      padding: 0.625rem 1.25rem;
      border-radius: 8px;
      font-size: 0.9375rem; font-weight: 600;
      text-decoration: none;
      transition: all 0.15s;
    }
    .btn-primary { background: var(--accent); color: white; }
    .btn-primary:hover { background: var(--accent-mid); transform: translateY(-1px); box-shadow: 0 4px 14px rgba(99,102,241,0.4); }
    .btn-outline {
      background: transparent; color: var(--text);
      border: 1px solid var(--border);
    }
    .btn-outline:hover { border-color: var(--accent); color: var(--accent-high); }


    .hero-flows {
      display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;
    }
    .flow-box {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 1rem 1.125rem;
      font-size: 0.8125rem;
    }
    .flow-box--bad  { border-color: rgba(248,113,113,0.25); }
    .flow-box--good { border-color: rgba(34,197,94,0.25); }
    .flow-header {
      display: flex; align-items: center; gap: 0.4rem;
      font-family: var(--mono); font-size: 0.6875rem; font-weight: 600;
      text-transform: uppercase; letter-spacing: 0.08em;
      margin-bottom: 0.75rem;
    }
    .flow-header--bad  { color: var(--danger); }
    .flow-header--good { color: var(--success); }
    .flow-step {
      display: flex; align-items: flex-start; gap: 0.5rem;
      color: var(--text-muted);
      font-size: 0.78125rem;
      line-height: 1.4;
      padding: 0.3rem 0;
    }
    .flow-step-icon { flex-shrink: 0; font-size: 0.875rem; line-height: 1.4; }
    .flow-step-sub {
      display: block;
      font-size: 0.6875rem;
      color: var(--text-dim);
      margin-top: 0.1rem;
    }
    .flow-arrow {
      text-align: center;
      color: var(--text-dim);
      font-size: 0.75rem;
      padding: 0.1rem 0;
      padding-left: 1.375rem;
    }
    .flow-result {
      margin-top: 0.5rem;
      background: var(--bg-code);
      border: 1px solid var(--border);
      border-radius: 5px;
      padding: 0.375rem 0.625rem;
      font-family: var(--mono);
      font-size: 0.6875rem;
      line-height: 1.5;
    }
    .flow-result--bad  { color: var(--danger); opacity: 0.7; }
    .flow-result--good { color: var(--success); }


    .hero-output {
      background: var(--bg-code);
      border: 1px solid rgba(99,102,241,0.35);
      border-radius: 10px;
      padding: 0.875rem 1.25rem;
      font-family: var(--mono);
      font-size: 0.8125rem;
      line-height: 1.8;
    }
    .hero-output-cmd { color: #f1f5f9; margin-bottom: 0.5rem; }
    .hero-output-row { display: block; }
    .hor  { color: var(--text-dim); margin-right: 0.375rem; }
    .hok  { color: #60a5fa; display: inline-block; min-width: 4rem; }
    .hos  { color: #4ade80; }
    .hod  { color: var(--text-dim); }
    .hog  { color: var(--success); }
    .hob  { color: var(--danger); }


    .pos { color: var(--cyan); }


    .terminal-wrap {
      position: relative;
    }
    .terminal {
      position: relative; z-index: 1;
      background: #0c0c10;
      border: 1px solid rgba(255,255,255,0.08);
      border-radius: 12px;
      overflow: hidden;
      font-family: var(--mono);
      font-size: 0.8125rem;
      box-shadow:
        0 0 0 1px rgba(99,102,241,0.08),
        0 24px 64px rgba(0,0,0,0.6),
        0 4px 16px rgba(0,0,0,0.4);
    }
    .terminal-bar {
      background: #16161a;
      padding: 0.625rem 1rem;
      display: flex; align-items: center; gap: 0.5rem;
      border-bottom: 1px solid rgba(255,255,255,0.06);
    }
    .dot { width: 12px; height: 12px; border-radius: 50%; }
    .dot-r { background: #ff5f57; }
    .dot-y { background: #ffbd2e; }
    .dot-g { background: #28c840; }
    .terminal-title {
      margin: 0 auto;
      font-size: 0.6875rem; color: var(--text-dim);
      font-family: var(--sans);
    }
    .terminal-output {
      padding: 1.25rem; line-height: 1.75;
      min-height: 14rem;
    }

    .tl { display: block; }
    @keyframes tFadeIn {
      from { opacity: 0; transform: translateX(-3px); }
      to   { opacity: 1; transform: translateX(0); }
    }
    .tl.animate { animation: tFadeIn 0.07s ease forwards; }


    .cmd   { color: #f1f5f9; }
    .k     { color: #60a5fa; }
    .s     { color: #4ade80; }
    .d     { color: var(--text-dim); }
    .sec   { color: var(--warn); }
    .appeared { color: var(--success); font-weight: 500; }
    .changed  { color: var(--warn);    font-weight: 500; }
    .removed  { color: var(--danger);  font-weight: 500; }
    .punc  { color: var(--text-dim); }


    .cursor {
      display: inline-block;
      color: var(--accent-high);
      animation: blink 1s step-end infinite;
    }
    @keyframes blink {
      0%, 100% { opacity: 1; }
      50%       { opacity: 0; }
    }


    section { max-width: 1100px; margin: 0 auto; padding: 5rem 2rem; }
    @media (max-width: 820px) { section { padding: 3rem 1.25rem; } }
    .section-label {
      font-size: 0.6875rem; font-weight: 600; text-transform: uppercase;
      letter-spacing: 0.1em; color: var(--accent-high);
      margin-bottom: 0.75rem;
    }
    h2 {
      font-size: clamp(1.75rem, 3.5vw, 2.375rem);
      font-weight: 700;
      letter-spacing: -0.03em;
      color: var(--text);
      margin-bottom: 0.625rem;
    }
    .section-sub {
      color: var(--text-muted); font-size: 1.0625rem;
      line-height: 1.7;
      margin-bottom: 1.75rem;
    }
    .divider {
      border: none; border-top: 1px solid var(--border-soft);
      max-width: 1100px; margin: 0 auto;
    }


    .feature-grid {
      display: grid; grid-template-columns: 1fr 1fr; gap: 3.5rem; align-items: start;
    }
    @media (max-width: 820px) { .feature-grid { grid-template-columns: 1fr; gap: 2rem; } }
    .feature-desc p {
      color: var(--text-muted); font-size: 1rem; line-height: 1.75; margin-bottom: 1.125rem;
    }
    .describe-output { display: flex; flex-direction: column; }
    .describe-output-label {
      font-family: var(--mono); font-size: 0.6875rem; font-weight: 600;
      text-transform: uppercase; letter-spacing: 0.1em;
      color: var(--text-dim); margin-bottom: 0.875rem;
    }
    .describe-output-block {
      background: var(--bg-code);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 1.25rem 1.375rem;
      font-family: var(--mono); font-size: 0.8125rem;
      line-height: 1.85;
    }
    .feature-stats {
      display: flex; gap: 0.75rem; flex-wrap: wrap; margin-top: 1.25rem;
    }
    .feature-stat {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 0.625rem 1rem;
      text-align: center;
    }
    .feature-stat-num {
      display: block;
      font-family: var(--mono); font-size: 1.375rem; font-weight: 700;
      color: var(--text); line-height: 1.2; letter-spacing: -0.03em;
      font-variant-numeric: tabular-nums;
    }
    .feature-stat-label {
      display: block; font-size: 0.8125rem; color: var(--text-muted); margin-top: 0.25rem;
    }


    .loop-compare {
      display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem;
    }
    @media (max-width: 820px) { .loop-compare { grid-template-columns: 1fr; } }
    .loop-box {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 1.25rem;
    }
    .loop-box--bad  { border-color: rgba(248,113,113,0.2); }
    .loop-box--good { border-color: rgba(34,197,94,0.2); }
    .loop-title {
      font-family: var(--mono); font-size: 0.6875rem; font-weight: 600;
      text-transform: uppercase; letter-spacing: 0.08em;
      margin-bottom: 1rem;
    }
    .loop-title--bad  { color: var(--danger); }
    .loop-title--good { color: var(--success); }
    .loop-steps { display: flex; flex-direction: column; gap: 0; }
    .loop-item {
      display: flex; align-items: flex-start; gap: 0.625rem;
      padding: 0.375rem 0;
      font-size: 0.8125rem; color: var(--text-muted);
    }
    .loop-item-icon { flex-shrink: 0; width: 1.25rem; text-align: center; }
    .loop-item-connector {
      width: 1px; height: 1rem;
      background: var(--border);
      margin-left: 0.5625rem;
      margin-top: -0.125rem; margin-bottom: -0.125rem;
    }
    .loop-cost {
      margin-top: 0.875rem;
      padding-top: 0.875rem;
      border-top: 1px solid var(--border-soft);
      font-family: var(--mono); font-size: 0.8125rem;
    }
    .loop-cost-bad  { color: var(--danger); }
    .loop-cost-good { color: var(--success); }


    .bench-stat-row {
      display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem;
      margin-bottom: 1.75rem;
    }
    @media (max-width: 820px) { .bench-stat-row { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 480px) { .bench-stat-row { grid-template-columns: 1fr; } }
    .bench-stat {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 1.25rem 1.5rem;
      text-align: center;
    }
    .bench-stat-num {
      display: block;
      font-family: var(--mono);
      font-size: 2rem; font-weight: 700;
      color: var(--text);
      line-height: 1.15;
      letter-spacing: -0.04em;
      font-variant-numeric: tabular-nums;
    }
    .bench-stat-label {
      display: block;
      font-size: 0.8125rem; color: var(--text-muted);
      margin-top: 0.375rem;
      line-height: 1.4;
    }


    .bench-chart { margin-bottom: 2.5rem; }
    .bench-row {
      display: grid;
      grid-template-columns: 7rem 1fr 6rem;
      align-items: center;
      gap: 0.75rem;
      margin-bottom: 0.875rem;
    }
    @media (max-width: 600px) {
      .bench-row { grid-template-columns: 5.5rem 1fr 5rem; gap: 0.5rem; }
    }
    .bench-name {
      font-size: 0.8125rem; font-weight: 600;
      color: var(--text); text-align: right;
    }
    .bench-name.ours { color: var(--accent-high); }
    .bench-track {
      position: relative;
      height: 28px;
      background: rgba(255,255,255,0.03);
      border: 1px solid var(--border-soft);
      border-radius: 4px;
      overflow: hidden;
    }
    .bench-bar {
      position: absolute; top: 0; left: 0;
      height: 100%;
      border-radius: 3px;
      transform: scaleX(0);
      transform-origin: left center;
      transition: transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .bench-row.in-view .bench-bar { transform: scaleX(1); }

    /* farscry bar is nearly invisible at scale — THAT IS THE MESSAGE */
    .bench-bar--ours {
      width: max(6px, 1%);  /* 38/3800 ≈ 1% */
      background: linear-gradient(to right, var(--accent), #818cf8);
    }
    .bench-bar--mid {
      width: 65.8%;  /* 2500/3800 */
      background: var(--text-dim);
    }
    .bench-bar--slow {
      width: 100%;
      background: linear-gradient(to right, #7f1d1d, #991b1b);
    }
    .bench-num {
      font-family: var(--mono);
      font-size: 0.8125rem;
      color: var(--text-muted);
    }
    .bench-num.ours {
      color: var(--accent-high); font-weight: 600;
    }
    .bench-mult {
      display: inline-block;
      background: rgba(127,29,29,0.25);
      color: var(--danger);
      border-radius: 3px;
      padding: 0 0.3rem;
      font-size: 0.7rem;
      font-family: var(--mono);
      margin-left: 0.3rem;
    }


    .bench-failure-callout {
      display: flex; align-items: center; gap: 1.5rem;
      background: rgba(248,113,113,0.05);
      border: 1px solid rgba(248,113,113,0.2);
      border-radius: 10px;
      padding: 1.125rem 1.5rem;
      margin-bottom: 2.5rem;
      flex-wrap: wrap;
    }
    .bfc-num {
      font-family: var(--mono); font-size: 2.75rem; font-weight: 700;
      color: var(--danger); flex-shrink: 0; line-height: 1;
    }
    .bfc-text {
      flex: 1; min-width: 200px;
      font-size: 0.9375rem; color: var(--text-muted); line-height: 1.55;
    }
    .bfc-text strong { color: var(--text); }
    .bfc-source {
      display: block; margin-top: 0.3rem;
      font-family: var(--mono); font-size: 0.75rem; color: var(--text-dim);
    }


    .bench-cost-callout {
      display: flex; align-items: center; gap: 1.5rem;
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 1.125rem 1.5rem;
      margin-bottom: 2.5rem;
      flex-wrap: wrap;
    }
    .cost-item {
      display: flex; flex-direction: column; align-items: center;
    }
    .cost-num {
      font-family: var(--mono); font-size: 1.375rem; font-weight: 700;
      line-height: 1.2;
    }
    .cost-num--bad { color: var(--danger); }
    .cost-num--good { color: var(--success); }
    .cost-label { font-size: 0.75rem; color: var(--text-muted); margin-top: 0.2rem; }
    .cost-arrow {
      font-size: 1.25rem; color: var(--text-dim); flex-shrink: 0;
    }
    .cost-context {
      flex: 1; min-width: 200px;
      font-size: 0.875rem; color: var(--text-muted); line-height: 1.5;
    }
    .cost-context strong { color: var(--text); }

    /* ─────────── COST TABLE ─────────── */
    .cost-table-wrap { margin-bottom: 2.5rem; }
    .cost-table {
      width: 100%; border-collapse: collapse;
      font-family: var(--mono); font-size: 0.8125rem;
      margin-bottom: 1.25rem;
      border: 1px solid var(--border);
      border-radius: 10px; overflow: hidden;
    }
    .cost-table th {
      background: var(--bg-card);
      color: var(--accent-high);
      font-size: 0.6875rem; font-weight: 700;
      text-transform: uppercase; letter-spacing: 0.06em;
      padding: 0.625rem 1rem; text-align: left;
      border-bottom: 1px solid var(--border);
    }
    .cost-table td {
      padding: 0.75rem 1rem;
      border-bottom: 1px solid var(--border-soft);
      color: var(--text-muted);
    }
    .cost-table tbody tr:last-child td { border-bottom: none; }
    .cost-table tbody tr:hover td { background: rgba(99,102,241,0.04); }
    .cost-td-bad  { color: var(--danger) !important; font-weight: 600; }
    .cost-td-good { color: var(--success) !important; font-weight: 700; }
    .cost-td-res  { color: var(--text); font-weight: 500; }

    .cost-annual-row {
      display: flex; align-items: center; gap: 1rem;
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 1.25rem 1.5rem;
      flex-wrap: wrap; margin-bottom: 1rem;
    }
    .cost-annual-item { display: flex; flex-direction: column; align-items: center; }
    .cost-annual-num {
      font-family: var(--mono); font-size: 1.5rem; font-weight: 700; line-height: 1.1;
    }
    .cost-annual--bad  { color: var(--danger); }
    .cost-annual--good { color: var(--success); }
    .cost-annual-label {
      font-size: 0.6875rem; color: var(--text-dim);
      margin-top: 0.25rem; white-space: nowrap;
    }
    .cost-annual-arrow { font-size: 1.25rem; color: var(--text-dim); flex-shrink: 0; }
    .cost-annual-divider {
      width: 1px; height: 2.5rem; background: var(--border);
      flex-shrink: 0; margin: 0 0.5rem;
    }
    .cost-footnote {
      font-family: var(--mono); font-size: 0.75rem; color: var(--text-dim);
      line-height: 1.7; border-left: 2px solid var(--border);
      padding-left: 0.875rem;
    }
    @media (max-width: 820px) {
      .cost-table { font-size: 0.75rem; }
      .cost-table th, .cost-table td { padding: 0.5rem 0.625rem; }
      .cost-annual-divider { display: none; }
    }

    .bench-repro {
      text-align: center; margin-top: 0.5rem;
    }
    .bench-repro a {
      font-family: var(--mono); font-size: 0.8125rem; color: var(--text-dim);
      text-decoration: none;
    }
    .bench-repro a:hover { color: var(--accent-high); }


    .cards {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1.25rem;
    }
    @media (max-width: 820px) { .cards { grid-template-columns: 1fr; } }
    .card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 1.75rem;
      transition: border-color 0.2s;
    }
    .card:hover { border-color: rgba(255,255,255,0.18); }
    .card-tag {
      display: inline-block;
      font-family: var(--mono); font-size: 0.6875rem; font-weight: 600;
      color: var(--accent-high);
      background: var(--accent-low);
      border: 1px solid rgba(99,102,241,0.3);
      padding: 0.15rem 0.5rem;
      border-radius: 4px;
      margin-bottom: 0.875rem;
      letter-spacing: 0.04em;
    }
    .card h3 { font-size: 1.0625rem; font-weight: 600; color: var(--text); margin-bottom: 0.5rem; letter-spacing: -0.01em; }
    .card p { font-size: 0.9375rem; color: var(--text-muted); margin-bottom: 1.25rem; line-height: 1.65; }
    .card-code {
      background: var(--bg-code);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 0.875rem 1rem;
      font-family: var(--mono);
      font-size: 0.8125rem;
      color: var(--text-muted);
      line-height: 1.65;
    }


    .install-ways {
      display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem;
      margin-bottom: 2rem;
    }
    @media (max-width: 820px) { .install-ways { grid-template-columns: 1fr; } }
    .install-way {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 1.75rem;
      transition: border-color 0.2s;
    }
    .install-way:hover { border-color: rgba(255,255,255,0.18); }
    .install-way-letter {
      display: flex; align-items: center; justify-content: center;
      width: 2rem; height: 2rem;
      background: var(--accent-low);
      border: 1px solid rgba(99,102,241,0.25);
      border-radius: 6px;
      font-family: var(--mono); font-size: 0.875rem; font-weight: 700;
      color: var(--accent-high);
      margin-bottom: 0.875rem;
    }
    .install-way h3 { font-size: 1.0625rem; font-weight: 600; color: var(--text); margin-bottom: 0.5rem; letter-spacing: -0.01em; }
    .install-way p { font-size: 0.9375rem; color: var(--text-muted); margin-bottom: 1.25rem; line-height: 1.65; }
    .code-block {
      background: var(--bg-code);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 1.5rem 1.75rem;
      font-family: var(--mono);
      font-size: 0.875rem;
      line-height: 1.8;
      overflow-x: auto;
    }
    .code-block .c  { color: var(--text-dim); }
    .code-block .cm { color: var(--text); font-weight: 500; }


    .vasp-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; align-items: start; }
    @media (max-width: 820px) { .vasp-grid { grid-template-columns: 1fr; gap: 2rem; } }
    .vasp-desc p { color: var(--text-muted); font-size: 0.9375rem; line-height: 1.7; margin-bottom: 1rem; }
    .vasp-desc a { color: var(--accent-high); text-decoration: none; }
    .vasp-desc a:hover { text-decoration: underline; }
    .analogy {
      background: var(--bg-card);
      border-left: 2px solid rgba(255,255,255,0.12);
      border-radius: 0 8px 8px 0;
      padding: 1rem 1.25rem;
      font-family: var(--mono);
      font-size: 0.8125rem;
      color: var(--text-muted);
      margin-top: 1.5rem; line-height: 1.8;
    }
    .analogy strong { color: var(--text-dim); display: block; margin-bottom: 0.375rem; font-size: 0.6875rem; letter-spacing: 0.1em; text-transform: uppercase; }
    .vasp-term-body { padding: 1.25rem; line-height: 1.75; }


    /* ─────────── BENCHMARK: BIG NUMBER (Turbopack-style) ─────────── */
    .perf-hero {
      text-align: center;
      padding: 1.5rem 0 1rem;
    }
    .perf-number {
      font-family: var(--mono);
      font-size: clamp(6rem, 18vw, 11rem);
      font-weight: 700;
      letter-spacing: -0.05em;
      line-height: 0.9;
      color: var(--text);
      display: block;
      font-variant-numeric: tabular-nums;
    }
    .perf-number-unit { color: var(--accent-high); }
    .perf-context {
      font-size: clamp(1.125rem, 2.5vw, 1.375rem);
      color: var(--text-muted);
      margin-top: 1.5rem;
      letter-spacing: -0.01em;
      font-weight: 400;
    }
    .perf-meta {
      font-family: var(--mono);
      font-size: 0.875rem;
      color: var(--text-dim);
      margin-top: 0.75rem;
      letter-spacing: 0;
    }
    .perf-separator {
      height: 1px;
      background: var(--border-soft);
      margin: 2rem 0;
    }
    .perf-stats-row {
      display: flex; align-items: flex-start;
      padding-top: 1.75rem; margin-top: 1.75rem;
      border-top: 1px solid var(--border-soft);
    }
    .perf-stat-item {
      flex: 1; text-align: center; padding: 0 2rem;
    }
    .perf-stat-item + .perf-stat-item {
      border-left: 1px solid var(--border-soft);
    }
    .perf-stat-big {
      font-family: var(--mono);
      font-size: clamp(2rem, 4.5vw, 3rem);
      font-weight: 700; letter-spacing: -0.04em;
      color: var(--text); display: block;
      font-variant-numeric: tabular-nums;
    }
    .perf-stat-l1 {
      display: block; font-size: 0.9375rem;
      color: var(--text-muted); margin-top: 0.5rem;
    }
    .perf-stat-l2 {
      display: block; font-size: 0.8125rem;
      color: var(--text-dim); font-family: var(--mono);
      margin-top: 0.2rem;
    }
    @media (max-width: 640px) {
      .perf-stats-row { flex-direction: column; gap: 0; }
      .perf-stat-item { padding: 1.25rem 0; text-align: left; }
      .perf-stat-item + .perf-stat-item {
        border-left: none; border-top: 1px solid var(--border-soft);
      }
    }
    /* ─────────── FULL COMPARISON TABLE ─────────── */
    .compare-section { max-width: 700px; margin: 0 auto; }
    .compare-group { margin-bottom: 2rem; }
    .compare-group-label {
      font-family: var(--mono); font-size: 0.6875rem; font-weight: 700;
      text-transform: uppercase; letter-spacing: 0.12em;
      color: var(--text-dim);
      padding-bottom: 0.5rem;
      border-bottom: 1px solid var(--border-soft);
      margin-bottom: 0;
    }
    .compare-row {
      display: flex; align-items: baseline; gap: 0.75rem;
      padding: 0.75rem 0;
      border-bottom: 1px solid var(--border-soft);
      font-size: 0.9375rem;
      flex-wrap: wrap;
    }
    .compare-what { color: var(--text-muted); flex: 1; min-width: 160px; }
    .compare-from {
      font-family: var(--mono); color: var(--danger);
      font-size: 0.875rem; white-space: nowrap; opacity: 0.85;
    }
    .compare-arr { color: var(--text-dim); flex-shrink: 0; }
    .compare-to {
      font-family: var(--mono); color: var(--text);
      font-weight: 600; white-space: nowrap;
    }
    .compare-to--zero { color: #fafafa; }
    .compare-mult {
      font-family: var(--mono); font-size: 0.8125rem;
      color: var(--accent-high); font-weight: 600;
      margin-left: auto; white-space: nowrap;
    }

    /* ─────────── DIFF: FLOWING TIMELINE ─────────── */
    .diff-timeline { display: flex; flex-direction: column; gap: 0.625rem; }
    .diff-track {
      display: flex; align-items: center; gap: 1rem;
      padding: 1.25rem 1.5rem;
      border-radius: 10px;
      border: 1px solid var(--border-soft);
      flex-wrap: wrap;
    }
    .diff-track--bad  { background: rgba(248,113,113,0.04); }
    .diff-track--good { background: rgba(34,197,94,0.05); border-color: rgba(34,197,94,0.15); }
    .diff-track-who {
      font-family: var(--mono); font-size: 0.75rem; font-weight: 700;
      text-transform: uppercase; letter-spacing: 0.1em;
      width: 5.5rem; flex-shrink: 0;
    }
    .diff-track--bad  .diff-track-who { color: var(--text-dim); }
    .diff-track--good .diff-track-who { color: var(--success); }
    .diff-steps { display: flex; align-items: center; gap: 0.375rem; flex: 1; flex-wrap: wrap; }
    .diff-step { font-size: 0.9375rem; color: var(--text-muted); white-space: nowrap; }
    .diff-step--bad { color: var(--danger); font-weight: 500; opacity: 0.9; }
    .diff-step--good { color: var(--success); font-weight: 600; }
    .diff-arr { color: var(--text-dim); font-size: 0.875rem; }
    .diff-track-price {
      font-family: var(--mono); font-size: 0.875rem; font-weight: 600;
      margin-left: auto; white-space: nowrap; flex-shrink: 0;
    }
    .diff-track--bad  .diff-track-price { color: var(--danger); }
    .diff-track--good .diff-track-price { color: var(--success); }

    /* ─────────── THREE MODES: ASYMMETRIC ─────────── */
    .mode-primary { margin-bottom: 1.25rem; }
    .mode-primary-header {
      display: flex; align-items: center; gap: 1rem; margin-bottom: 1.25rem;
    }
    .mode-tag {
      font-family: var(--mono); font-size: 0.6875rem; font-weight: 600;
      text-transform: uppercase; letter-spacing: 0.1em;
      color: var(--accent-high);
      flex-shrink: 0;
    }
    .mode-primary-title {
      font-size: 1.0625rem; font-weight: 600; color: var(--text);
      letter-spacing: -0.01em;
    }
    .mode-primary-desc {
      font-size: 0.9375rem; color: var(--text-muted); margin-bottom: 1.25rem;
      max-width: 600px; line-height: 1.65;
    }
    .mode-pair {
      display: grid; grid-template-columns: 13fr 7fr; gap: 2rem;
      margin-top: 2rem; padding-top: 2rem;
      border-top: 1px solid var(--border-soft);
    }
    @media (max-width: 640px) { .mode-pair { grid-template-columns: 1fr; gap: 1.5rem; } }
    .mode-secondary {
      background: rgba(255,255,255,0.025);
      border-left: 3px solid rgba(99,102,241,0.55);
      border-radius: 0 10px 10px 0;
      padding: 1.375rem 1.375rem 1.375rem 1.5rem;
    }
    .mode-secondary-title {
      display: block; font-size: 1rem; font-weight: 600; color: var(--text);
      margin: 0.625rem 0 0.75rem; letter-spacing: -0.01em;
    }
    .mode-secondary p {
      font-size: 0.9rem; color: var(--text-muted); margin-bottom: 0.875rem; line-height: 1.6;
    }
    .mode-secondary .card-code {
      font-size: 0.75rem; white-space: nowrap; overflow-x: auto;
      background: transparent; border: none; padding: 0;
      color: var(--text-dim);
    }
    .mode-note {
      font-family: var(--mono); font-size: 0.75rem;
      color: var(--text-dim); margin-top: 0.75rem;
      line-height: 1.5;
    }

    /* ─────────── MODE SEPARATOR ─────────── */
    .mode-block {
      margin-top: 2rem; padding-top: 2rem;
      border-top: 1px solid var(--border-soft);
    }
    .mode-lone {
      margin-top: 1.5rem;
    }

    /* ─────────── INSTALL: PACKAGE MANAGER LIST ─────────── */
    .install-methods {
      border: 1px solid var(--border);
      border-radius: 10px; overflow: hidden;
      background: var(--bg-code);
      margin-bottom: 1.25rem;
    }
    .install-method {
      display: flex; align-items: center;
      padding: 0.8125rem 1.25rem;
      border-bottom: 1px solid var(--border-soft);
      gap: 1.5rem; font-family: var(--mono);
    }
    .install-method:last-child { border-bottom: none; }
    .install-method:hover { background: rgba(255,255,255,0.02); }
    .install-method:hover .im-copy { opacity: 1; }
    .im-label {
      color: var(--text-dim); font-size: 0.6875rem;
      width: 5.5rem; flex-shrink: 0;
      letter-spacing: 0.06em; text-transform: uppercase;
    }
    .im-cmd { color: var(--text); font-size: 0.9rem; font-weight: 500; flex: 1; }
    .im-copy {
      opacity: 0; flex-shrink: 0;
      padding: 0.2rem 0.5rem;
      font-size: 0.6875rem; font-family: var(--mono);
      color: var(--text-dim);
      background: transparent;
      border: 1px solid var(--border);
      border-radius: 4px; cursor: pointer;
      transition: opacity 0.15s, color 0.15s, border-color 0.15s;
    }
    .im-copy:hover { color: var(--text); border-color: rgba(255,255,255,0.18); }
    .im-copy.copied { color: var(--success); border-color: rgba(34,197,94,0.35); opacity: 1; }
    .install-setup {
      display: flex; align-items: center; gap: 1.5rem; flex-wrap: wrap;
      background: var(--bg-code); border: 1px solid var(--border);
      border-radius: 10px; padding: 0.9375rem 1.25rem;
      margin-bottom: 1rem;
    }
    .install-setup-cmd { font-family: var(--mono); flex: 1; }
    .install-prompt { color: var(--text-dim); margin-right: 0.5rem; user-select: none; }
    .install-cmd-text { color: var(--text); font-size: 0.9375rem; font-weight: 500; }
    .install-setup-note { font-size: 0.875rem; color: var(--text-dim); }
    .install-note {
      font-size: 0.8125rem; color: var(--text-dim); margin-top: 0.75rem;
      font-family: var(--mono);
    }
    .install-note code { color: var(--accent-high); }

    footer {
      border-top: 1px solid var(--border-soft);
      padding: 3rem 2rem;
      text-align: center;
      color: var(--text-dim);
      font-size: 0.875rem;
      line-height: 1.8;
    }
    footer a { color: var(--text-dim); text-decoration: none; transition: color 0.15s; }
    footer a:hover { color: var(--text-muted); }
  </style>
</head>
<body>

